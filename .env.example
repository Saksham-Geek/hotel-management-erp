# --- Database ---
# Owner role: used ONLY by migrations and seed scripts (never by the running API).
DATABASE_ADMIN_URL=postgres://erp_owner:erp_owner_dev@localhost:5433/erp
# Restricted role: used by the API at runtime. Subject to row-level security.
DATABASE_URL=postgres://erp_app:erp_app_dev@localhost:5433/erp
# Password given to the erp_app role when migrations create it (must match DATABASE_URL).
APP_DB_PASSWORD=erp_app_dev

# --- API ---
PORT=4000
# Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
JWT_EXPIRES_IN=8h
# 32-byte hex key for AES-256-GCM guest identity/document encryption (openssl rand -hex 32)
GUEST_DOCUMENT_ENCRYPTION_KEY=replace-with-64-hex-characters

# --- Web ---
API_URL=http://localhost:4000
